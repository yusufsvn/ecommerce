DB_HOST=localhost
DB_PORT=port
DB_USER=username
DB_PASSWORD=password
DB_NAME=dbname
DB_SSLMODE=disable

# MinIO Settings
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_URL=localhost:9000
MINIO_BUCKET_NAME=go-ecommerce
MINIO_LOCATION=us-east-1
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin123
STORAGE_SSLMODE_IS_ACTIVE=false

# API SETTINGS
API_PORT=7116

# JWT Secret Key
SECRET_KEY=your_secret_key

# EXTERNAL API

IYZIPAY_API_KEY=your_api_key
IYZIPAY_API_SECRET=your_api_secret_key

# Oauth Credentials for google
CLIENT_ID=your_client_id
CLIENT_SECRET=your_client_secret
REDIRECT_URL=http://localhost:7116/api/auth/google/callback
